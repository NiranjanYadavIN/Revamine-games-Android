<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- 1. Squircle Background with Exact Linear Gradient and Subtle Border from user SVG -->
    <path
        android:pathData="M 116,16 H 396 A 100,100 0 0 1 496,116 V 396 A 100,100 0 0 1 396,496 H 116 A 100,100 0 0 1 16,396 V 116 A 100,100 0 0 1 116,16 Z"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="512"
                android:endY="512"
                android:type="linear">
                <item android:offset="0.0" android:color="#4F46E5" />
                <item android:offset="0.5" android:color="#7C3AED" />
                <item android:offset="1.0" android:color="#4338CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Controller Outer Rounded Rectangle -->
    <path
        android:pathData="M 194,178 H 318 A 54,54 0 0 1 372,232 V 280 A 54,54 0 0 1 318,334 H 194 A 54,54 0 0 1 140,280 V 232 A 54,54 0 0 1 194,178 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="22"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 3. D-Pad (Thick Rounded Plus) -->
    <!-- Horizontal Cross Bar -->
    <path
        android:pathData="M 184,256 H 240"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="22"
        android:strokeLineCap="round" />
    <!-- Vertical Cross Bar -->
    <path
        android:pathData="M 212,228 V 284"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="22"
        android:strokeLineCap="round" />

    <!-- 4. Action Buttons (Two solid white circles matching the uploaded logo) -->
    <!-- Top-Right Button (cx=310, cy=235, r=22) -->
    <path
        android:pathData="M 288,235 A 22,22 0 1,0 332,235 A 22,22 0 1,0 288,235 Z"
        android:fillColor="#FFFFFF" />
    <!-- Bottom-Left Button (cx=288, cy=281, r=22) -->
    <path
        android:pathData="M 266,281 A 22,22 0 1,0 310,281 A 22,22 0 1,0 266,281 Z"
        android:fillColor="#FFFFFF" />

</vector>
